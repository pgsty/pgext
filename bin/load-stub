#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PGEXT_SOURCE_DIR="${PGEXT_SOURCE_DIR:-$ROOT}"
if [ -x "$ROOT/pgext" ] && "$ROOT/pgext" doc load --help >/dev/null 2>&1; then
  exec "$ROOT/pgext" doc load "$@"
fi
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/pgext-doc.XXXXXX")
trap 'rm -f -- "$build_dir/pgext"; rmdir -- "$build_dir"' EXIT
go -C "$ROOT" build -o "$build_dir/pgext" .
"$build_dir/pgext" doc load "$@"
