[pigsty-pgsql]
name=pigsty-pgsql
baseurl=https://repo.pigsty.cc/yum/pgsql/el$releasever.$basearch
enabled=1
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-pigsty
module_hotfixes=1
priority=11

